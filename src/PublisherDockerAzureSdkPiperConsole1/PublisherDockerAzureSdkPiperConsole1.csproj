    <PackageReference Include="Azure.Provisioning.Deployment" Version="1.0.0-beta.2" />-->
    <PackageReference Include="Azure.ResourceManager.AppContainers" Version="1.6.0" />
    <PackageReference Include="Azure.ResourceManager.ContainerInstance" Version="1.4.0" />
    <PackageReference Include="Azure.ResourceManager.ManagedServiceIdentities" Version="1.4.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

