    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>83c00b00-e558-46a3-9541-ea0f60b2d463</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
