# ============================================================
# INFRASTRUCTURE CORE SETTINGS (OFFLINE CONFIGURATION)
# ============================================================

# The absolute directory path inside the container where your model files are stored
MODEL_PATH=/models/Qwen2.5-Coder-7B-Instruct

# Enforce a strict offline state to block internet/metadata network queries
HF_HUB_OFFLINE=1

# Maximum context length (adjust lower if you experience out-of-memory errors)
MAX_MODEL_LEN=8192


# ============================================================
# FRONTEND APPLICATION RUNTIME CONFIGURATION
# ============================================================

# Max simultaneous user requests permitted in the Gradio queue block
MAX_CONCURRENT_CHATS=4

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO