FROM python:3.11-slim

WORKDIR /download

RUN pip install --no-cache-dir huggingface_hub

# Override at runtime
ENV MODEL_NAME=""

# Expose /download as a volume so files persist on your host machine
VOLUME /download

CMD ["sh", "-c", "if [ -z \"$MODEL_NAME\" ]; then echo 'Error: MODEL_NAME environment variable is not set!'; exit 1; fi; \
    echo 'Starting download for: '$MODEL_NAME && \
    hf_name=$(echo $MODEL_NAME | awk -F/ '{print $NF}') && \
    python -c \"from huggingface_hub import snapshot_download; snapshot_download(repo_id='$MODEL_NAME', local_dir='/download/$hf_name')\""]


# Build command:
