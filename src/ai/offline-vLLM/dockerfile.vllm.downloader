FROM python:3.11-slim

WORKDIR /download

# Install the huggingface hub utility cleanly
RUN pip install --no-cache-dir "huggingface_hub[cli]"

# Default environment variables that you can override at runtime
ENV MODEL_NAME=""

# FIX: Calling the module directly via python -m ensures it is ALWAYS found
CMD sh -c "if [ -z \"\$MODEL_NAME\" ]; then echo '❌ Error: MODEL_NAME environment variable is not set!'; exit 1; fi; \
    echo '🚀 Starting download for: '\$MODEL_NAME && \
    hf_name=\$(echo \$MODEL_NAME | awk -F/ '{print \$NF}') && \
    python -m huggingface_hub.cli.huggingface_cli download \$MODEL_NAME --local-dir /download/\$hf_name"



