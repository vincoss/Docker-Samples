<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3" />
		<PackageReference Include="Azure.ResourceManager.AppContainers" Version="1.6.0" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
	</ItemGroup>

</Project>
